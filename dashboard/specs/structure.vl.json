{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Проблемная часть портфеля по взаимоисключающим классам риска на двух срезах. Источник: reporting.v_risk_by_dimension, dimension = risk_class.",
  "title": {
    "text": "Проблемная часть портфеля по классам риска",
    "subtitle": "Доля портфеля; классы не пересекаются, «без просрочки» не показан"
  },
  "data": {
    "url": "data/v_risk_by_dimension.json"
  },
  "transform": [
    {
      "filter": "datum.dimension == 'risk_class' && datum.dimension_value != 'Без просрочки'"
    },
    {
      "calculate": "slice(datum.report_date, 8, 10) + '.' + slice(datum.report_date, 5, 7) + '.' + slice(datum.report_date, 0, 4)",
      "as": "date_label"
    },
    {
      "calculate": "indexof(['Просрочка 1–30', 'Просрочка 31–90', 'NPL: просрочка 90+', 'NPL: реструктуризация'], datum.dimension_value)",
      "as": "class_order"
    },
    {
      "calculate": "+toDate(datum.report_date)",
      "as": "t"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "t",
          "as": "t_max"
        }
      ]
    },
    {
      "window": [
        {
          "op": "lag",
          "field": "share_of_portfolio",
          "as": "prev_share"
        }
      ],
      "groupby": [
        "dimension_value"
      ],
      "sort": [
        {
          "field": "t"
        }
      ]
    },
    {
      "calculate": "datum.prev_share == null ? null : max(datum.share_of_portfolio, datum.prev_share)",
      "as": "label_x"
    },
    {
      "calculate": "datum.prev_share == null ? null : format(datum.share_of_portfolio, '.1%') + '  ' + (round((datum.share_of_portfolio - datum.prev_share) * 1000) > 0 ? '+' : '') + format((datum.share_of_portfolio - datum.prev_share) * 100, '.1f') + ' п.п.'",
      "as": "label"
    },
    {
      "calculate": "datum.portfolio_kzt / 1e9",
      "as": "portfolio_bn"
    }
  ],
  "width": 250,
  "height": {
    "step": 44
  },
  "encoding": {
    "y": {
      "field": "dimension_value",
      "type": "nominal",
      "sort": {
        "field": "class_order",
        "op": "min"
      },
      "title": null
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "color": "#c3c2b7",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "share_of_portfolio",
          "type": "quantitative"
        },
        "detail": {
          "field": "dimension_value"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 130,
        "opacity": 1,
        "stroke": "#fcfcfb",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "share_of_portfolio",
          "type": "quantitative",
          "title": null,
          "scale": {
            "zero": true,
            "nice": true
          },
          "axis": {
            "format": ".0%",
            "grid": true,
            "tickCount": 5,
            "domain": false
          }
        },
        "color": {
          "field": "date_label",
          "type": "ordinal",
          "title": "Срез",
          "scale": {
            "range": [
              "#86b6ef",
              "#1c5cab"
            ]
          }
        },
        "tooltip": [
          {
            "field": "dimension_value",
            "title": "Класс"
          },
          {
            "field": "date_label",
            "title": "Срез"
          },
          {
            "field": "share_of_portfolio",
            "title": "Доля портфеля",
            "format": ".2%"
          },
          {
            "field": "portfolio_bn",
            "title": "млрд ₸",
            "format": ",.1f"
          },
          {
            "field": "loan_count",
            "title": "Кредитов"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.label != null"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 0,
        "fontSize": 11,
        "color": "#0b0b0b"
      },
      "encoding": {
        "x": {
          "value": 262
        },
        "text": {
          "field": "label"
        }
      }
    }
  ]
}
